APP_NAME="CeekayX HMS"
NODE_ENV=development
PORT=5000
API_VERSION=v1

DATABASE_URL="mysql://root:@localhost:3306/hms"

JWT_SECRET="replace-with-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-32-character-secret"
ACCESS_TOKEN_EXPIRES=7h
REFRESH_TOKEN_EXPIRES=7d

BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

CLIENT_URL="http://localhost:5173,http://localhost:4173,https://your-hospital-frontend.vercel.app"

LOG_LEVEL=info

UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SOCKET_PORT=5001

SYNC_BATCH_SIZE=100
SYNC_INTERVAL=30000

ENABLE_AUDIT_LOGS=false

DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LANGUAGE=en

ENABLE_SWAGGER=true
ENABLE_QUERY_LOGGING=true
ENABLE_REQUEST_LOGGING=true
