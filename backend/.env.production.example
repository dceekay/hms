APP_NAME="CeekayX HMS"
NODE_ENV=production
PORT=5002
API_VERSION=v1

DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/hms"

JWT_SECRET="replace-with-a-long-production-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-long-production-refresh-token-secret"
ACCESS_TOKEN_EXPIRES=7h
REFRESH_TOKEN_EXPIRES=7d

BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

CLIENT_URL="https://mds01.vercel.app"

LOG_LEVEL=info

UPLOAD_PATH="/var/www/hms/backend/uploads"
MAX_FILE_SIZE=10485760

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SOCKET_PORT=5001

SYNC_BATCH_SIZE=100
SYNC_INTERVAL=30000

ENABLE_AUDIT_LOGS=true

DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LANGUAGE=en

ENABLE_SWAGGER=false
ENABLE_QUERY_LOGGING=false
ENABLE_REQUEST_LOGGING=false
