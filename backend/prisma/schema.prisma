/**
 * ============================================================================
 * CeekayX Hospital Management System (HMS)
 * ============================================================================
 * Prisma Schema
 * Database: MySQL
 * This schema contains the security foundation of the application.
 * Modules:
 * - Users
 * - Roles
 * - Permissions
 * - Refresh Tokens
 * - Audit Logs
 * Future modules:
 * - Hospitals
 * - Patients
 * - Doctors
 * - Pharmacy
 * - Billing
 * - Laboratory
 * - Inventory
 * - Appointments
 * ============================================================================
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////////////////////////

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum BillPaymentStatus {
  pending
  paid
  cancelled
}

enum PatientGender {
  male
  female
  other
}

enum PatientStatus {
  active
  inactive
  deceased
}

enum PatientCategory {
  new_patient
  investigation_patient
  old_patient
}

enum AppointmentStatus {
  scheduled
  checked_in
  in_consultation
  completed
  cancelled
  no_show
}

enum BedStatus {
  available
  occupied
  maintenance
  reserved
}

enum EntryPersonType {
  patient
  patient_relative
  staff
  guest
}

enum SemsasTransferType {
  hospital_ambulance_to_other_hospital
  hospital_ambulance_to_this_hospital
  external_ambulance_to_this_hospital
}

enum DoctorType {
  medical_doctor
  visiting_consultant
  visiting_specialist
}

enum PharmacyMovementType {
  stock_in
  adjustment
  dispense
}

enum InventoryMovementType {
  stock_in
  stock_out
  adjustment
  damaged
  lost
  transfer
}

enum NotificationPriority {
  info
  success
  warning
  critical
}

enum LaboratoryRequestStatus {
  pending
  sample_collected
  in_progress
  completed
  cancelled
}

enum ClinicalEncounterStatus {
  open
  completed
  cancelled
}

enum PrescriptionStatus {
  sent_to_pharmacy
  dispensed
  cancelled
}

///////////////////////////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////////////////////////

model User {
  /// Primary Key
  id String @id @default(uuid()) @db.Char(36)

  /// Login
  email    String @unique @db.VarChar(150)
  username String @unique @db.VarChar(100)

  passwordHash String @db.VarChar(255)

  /// Personal Information
  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  phone String? @db.VarChar(30)

  /// Account Status
  isActive        Boolean @default(true)
  isEmailVerified Boolean @default(false)

  /// Security
  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  lastLogin DateTime?

  passwordChangedAt DateTime?

  serviceAreaId String?          @db.Char(36)
  serviceArea   HospitalService? @relation("UserServiceArea", fields: [serviceAreaId], references: [id], onDelete: SetNull)

  /// Offline Sync Version
  version Int @default(1)

  /// Audit Fields
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /// Relationships
  roles UserRole[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  securityEntryLogs SecurityEntryLog[]

  semsasTransfersRecorded SemsasTransfer[] @relation("SemsasRecordedBy")

  semsasTransfersFiled SemsasTransfer[] @relation("SemsasFiledBy")

  doctorProfile DoctorProfile?

  patientBillsRecorded PatientBill[] @relation("PatientBillsRecordedBy")

  pharmacyMovementsRecorded PharmacyStockMovement[] @relation("PharmacyMovementsRecordedBy")

  pharmacyDispensesRecorded PharmacyDispense[] @relation("PharmacyDispensesRecordedBy")

  pharmacySalesRecorded PharmacySale[] @relation("PharmacySalesRecordedBy")

  inventoryMovementsRecorded InventoryStockMovement[] @relation("InventoryMovementsRecordedBy")

  labRequestsRecorded LaboratoryRequest[] @relation("LabRequestsRecordedBy")

  labRequestsCompleted LaboratoryRequest[] @relation("LabRequestsCompletedBy")

  doctorEncounters ClinicalEncounter[] @relation("DoctorEncounters")

  doctorPrescriptions Prescription[] @relation("DoctorPrescriptions")

  appointmentsAsDoctor Appointment[] @relation("AppointmentDoctor")

  appointmentsRecorded Appointment[] @relation("AppointmentRecordedBy")

  notificationReads NotificationRead[]

  @@index([serviceAreaId])
  @@map("users")
}

///////////////////////////////////////////////////////////////////////////////
// PATIENT
///////////////////////////////////////////////////////////////////////////////

model Patient {
  id String @id @default(uuid()) @db.Char(36)

  mrn    String? @unique @db.VarChar(50)
  qrCode String? @unique @db.VarChar(120)

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  email String? @db.VarChar(150)
  phone String? @db.VarChar(30)

  photoUrl       String? @db.VarChar(500)
  photoDataUrl   String? @db.LongText
  photoMimeType  String? @db.VarChar(50)
  photoSizeBytes Int?
  photoWidth     Int?
  photoHeight    Int?

  dateOfBirth     DateTime
  gender          PatientGender
  status          PatientStatus   @default(active)
  patientCategory PatientCategory @default(new_patient)

  address String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  country String? @db.VarChar(100)

  emergencyContactName         String? @db.VarChar(150)
  emergencyContactPhone        String? @db.VarChar(30)
  emergencyContactRelationship String? @db.VarChar(80)

  bloodGroup String? @db.VarChar(10)
  genotype   String? @db.VarChar(10)
  allergies  String? @db.VarChar(500)

  insuranceProviderId     String?            @db.Char(36)
  insuranceProvider       InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insurancePolicyNumber   String?            @db.VarChar(100)
  insuranceCoverageStatus String?            @db.VarChar(80)

  semsasTransfers SemsasTransfer[]

  patientBills PatientBill[]

  pharmacyDispenses PharmacyDispense[]

  pharmacySales PharmacySale[]

  laboratoryRequests LaboratoryRequest[]

  clinicalEncounters ClinicalEncounter[]

  prescriptions Prescription[]

  appointments Appointment[]

  version               Int       @default(1)
  convertedToHospitalAt DateTime?
  reactivatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([insuranceProviderId])
  @@index([mrn])
  @@index([qrCode])
  @@index([status])
  @@index([patientCategory])
  @@map("patients")
}

model Appointment {
  id String @id @default(uuid()) @db.Char(36)

  appointmentNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId String @db.Char(36)
  doctor   User   @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Restrict)

  status AppointmentStatus @default(scheduled)

  scheduledFor DateTime @default(now())
  reason       String?  @db.VarChar(500)
  notes        String?  @db.VarChar(500)

  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("AppointmentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledFor])
  @@index([recordedById])
  @@map("appointments")
}

model Department {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@map("departments")
}

model Specialty {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("specialties")
}

model Ward {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  rooms Room[]
  beds  Bed[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("wards")
}

model Room {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @db.VarChar(150)
  roomNumber  String  @unique @db.VarChar(50)
  roomType    String? @db.VarChar(100)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  wardId String? @db.Char(36)
  ward   Ward?   @relation(fields: [wardId], references: [id], onDelete: SetNull)

  beds Bed[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([wardId])
  @@map("rooms")
}

model Bed {
  id String @id @default(uuid()) @db.Char(36)

  bedNumber String    @unique @db.VarChar(50)
  status    BedStatus @default(available)
  isActive  Boolean   @default(true)

  wardId String? @db.Char(36)
  ward   Ward?   @relation(fields: [wardId], references: [id], onDelete: SetNull)

  roomId String? @db.Char(36)
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([wardId])
  @@index([roomId])
  @@map("beds")
}

model HospitalService {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(150)
  code        String? @unique @db.VarChar(50)
  description String? @db.VarChar(500)
  price       Decimal @default(0) @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  staffMembers User[] @relation("UserServiceArea")

  patientBills PatientBill[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("hospital_services")
}

model PatientBill {
  id String @id @default(uuid()) @db.Char(36)

  invoiceNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  serviceId String          @db.Char(36)
  service   HospitalService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus BillPaymentStatus @default(pending)

  notes String? @db.VarChar(500)

  billedAt DateTime @default(now())

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("PatientBillsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([serviceId])
  @@index([paymentStatus])
  @@index([billedAt])
  @@index([recordedById])
  @@map("patient_bills")
}

model Medication {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @db.VarChar(150)
  genericName String? @db.VarChar(150)
  brandName   String? @db.VarChar(150)
  category    String? @db.VarChar(100)
  strength    String? @db.VarChar(80)
  dosageForm  String? @db.VarChar(80)
  unit         String  @default("unit") @db.VarChar(40)

  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  costPrice    Decimal @default(0) @db.Decimal(12, 2)

  currentStock Int @default(0)
  reorderLevel Int @default(10)

  batchNumber String?   @db.VarChar(80)
  expiryDate  DateTime?

  isActive Boolean @default(true)

  stockMovements PharmacyStockMovement[]
  dispenses      PharmacyDispense[]
  saleItems      PharmacySaleItem[]
  prescriptionItems PrescriptionItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, strength, dosageForm])
  @@index([name])
  @@index([category])
  @@index([currentStock])
  @@index([expiryDate])
  @@map("medications")
}

model PharmacyStockMovement {
  id String @id @default(uuid()) @db.Char(36)

  medicationId String     @db.Char(36)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  movementType PharmacyMovementType
  quantity     Int
  stockBefore  Int
  stockAfter   Int

  reason String? @db.VarChar(255)
  notes  String? @db.VarChar(500)

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("PharmacyMovementsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([medicationId])
  @@index([movementType])
  @@index([createdAt])
  @@index([recordedById])
  @@map("pharmacy_stock_movements")
}

model PharmacyDispense {
  id String @id @default(uuid()) @db.Char(36)

  invoiceNumber String @unique @db.VarChar(50)

  medicationId String     @db.Char(36)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)
  amountPaid   Decimal @default(0) @db.Decimal(12, 2)
  paymentStatus BillPaymentStatus @default(pending)
  instructions String? @db.VarChar(500)
  notes        String? @db.VarChar(500)

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("PharmacyDispensesRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  dispensedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([medicationId])
  @@index([patientId])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([dispensedAt])
  @@index([recordedById])
  @@map("pharmacy_dispenses")
}

model PharmacySale {
  id String @id @default(uuid()) @db.Char(36)

  invoiceNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus BillPaymentStatus @default(pending)

  notes String? @db.VarChar(500)

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("PharmacySalesRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  items PharmacySaleItem[]

  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([soldAt])
  @@index([recordedById])
  @@map("pharmacy_sales")
}

model PharmacySaleItem {
  id String @id @default(uuid()) @db.Char(36)

  saleId String       @db.Char(36)
  sale   PharmacySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  medicationId String     @db.Char(36)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  instructions String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([medicationId])
  @@map("pharmacy_sale_items")
}

model ClinicalEncounter {
  id String @id @default(uuid()) @db.Char(36)

  encounterNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId String @db.Char(36)
  doctor   User   @relation("DoctorEncounters", fields: [doctorId], references: [id], onDelete: Restrict)

  visitType      String? @db.VarChar(100)
  chiefComplaint String? @db.VarChar(500)
  history        String? @db.VarChar(1000)
  examination    String? @db.VarChar(1000)
  diagnosis      String? @db.VarChar(500)
  remarks        String? @db.VarChar(1000)
  plan           String? @db.VarChar(1000)

  status ClinicalEncounterStatus @default(open)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([startedAt])
  @@map("clinical_encounters")
}

model Prescription {
  id String @id @default(uuid()) @db.Char(36)

  prescriptionNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId String @db.Char(36)
  doctor   User   @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Restrict)

  encounterId String?             @db.Char(36)
  encounter   ClinicalEncounter?  @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status PrescriptionStatus @default(sent_to_pharmacy)

  notes String? @db.VarChar(500)

  items PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([encounterId])
  @@index([status])
  @@index([createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id String @id @default(uuid()) @db.Char(36)

  prescriptionId String       @db.Char(36)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicationId String?     @db.Char(36)
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  medicationName String  @db.VarChar(150)
  strength       String? @db.VarChar(80)
  dosageForm     String? @db.VarChar(80)
  dose           String  @db.VarChar(120)
  frequency      String  @db.VarChar(120)
  duration       String  @db.VarChar(120)
  quantity       Int?
  instructions   String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([prescriptionId])
  @@index([medicationId])
  @@map("prescription_items")
}

model LaboratoryTemplate {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(150)
  code        String? @unique @db.VarChar(50)
  category    String? @db.VarChar(100)
  specimen    String? @db.VarChar(100)
  reportTitle String? @db.VarChar(150)

  fields Json

  notes    String? @db.VarChar(500)
  isActive Boolean @default(true)

  requests LaboratoryRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([isActive])
  @@map("laboratory_templates")
}

model LaboratoryRequest {
  id String @id @default(uuid()) @db.Char(36)

  requestNumber String @unique @db.VarChar(50)

  patientId String  @db.Char(36)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  templateId String             @db.Char(36)
  template   LaboratoryTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  status LaboratoryRequestStatus @default(pending)

  clinicalNotes String? @db.VarChar(500)
  resultValues  Json?
  interpretation String? @db.VarChar(500)
  technicianNote String? @db.VarChar(500)

  sampleCollectedAt DateTime?
  completedAt       DateTime?

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("LabRequestsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  completedById String? @db.Char(36)
  completedBy   User?   @relation("LabRequestsCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([templateId])
  @@index([status])
  @@index([requestNumber])
  @@index([createdAt])
  @@index([recordedById])
  @@index([completedById])
  @@map("laboratory_requests")
}

model InventoryItem {
  id String @id @default(uuid()) @db.Char(36)

  name        String  @db.VarChar(150)
  code        String? @unique @db.VarChar(50)
  category    String? @db.VarChar(100)
  itemType    String? @db.VarChar(80)
  description String? @db.VarChar(500)

  unit       String  @default("unit") @db.VarChar(40)
  location   String? @db.VarChar(150)
  department String? @db.VarChar(150)
  supplier   String? @db.VarChar(150)

  serialNumber String? @unique @db.VarChar(100)
  batchNumber  String? @db.VarChar(80)

  costPrice Decimal @default(0) @db.Decimal(12, 2)

  currentStock Int @default(0)
  reorderLevel Int @default(5)

  isConsumable Boolean @default(true)
  isActive     Boolean @default(true)

  notes String? @db.VarChar(500)

  movements InventoryStockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([category])
  @@index([department])
  @@index([location])
  @@index([currentStock])
  @@map("inventory_items")
}

model InventoryStockMovement {
  id String @id @default(uuid()) @db.Char(36)

  itemId String        @db.Char(36)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  movementType InventoryMovementType
  quantity     Int
  stockBefore  Int
  stockAfter   Int

  reason      String? @db.VarChar(255)
  destination String? @db.VarChar(150)
  issuedTo    String? @db.VarChar(150)
  notes       String? @db.VarChar(500)

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("InventoryMovementsRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([movementType])
  @@index([createdAt])
  @@index([recordedById])
  @@map("inventory_stock_movements")
}

model AppNotification {
  id String @id @default(uuid()) @db.Char(36)

  title    String @db.VarChar(150)
  message  String @db.VarChar(500)
  eventKey String @db.VarChar(100)

  priority NotificationPriority @default(info)

  targetRole   String? @db.VarChar(100)
  targetUserId String? @db.Char(36)

  linkUrl  String? @db.VarChar(255)
  metadata Json?

  readReceipts NotificationRead[]

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([targetRole])
  @@index([targetUserId])
  @@index([eventKey])
  @@index([priority])
  @@index([createdAt])
  @@map("app_notifications")
}

model NotificationRead {
  id String @id @default(uuid()) @db.Char(36)

  notificationId String          @db.Char(36)
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

model InsuranceProvider {
  id String @id @default(uuid()) @db.Char(36)

  name                 String  @unique @db.VarChar(150)
  code                 String? @unique @db.VarChar(50)
  email                String? @db.VarChar(150)
  phone                String? @db.VarChar(30)
  address              String? @db.VarChar(255)
  description          String? @db.VarChar(500)
  patientPayPercentage Decimal @default(0) @db.Decimal(5, 2)
  isActive             Boolean @default(true)

  patients Patient[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("insurance_providers")
}

model SemsasTransfer {
  id String @id @default(uuid()) @db.Char(36)

  transferType SemsasTransferType

  patientId String?  @db.Char(36)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  patientName  String  @db.VarChar(150)
  patientPhone String? @db.VarChar(30)

  fromFacility String @db.VarChar(180)
  toFacility   String @db.VarChar(180)

  ambulanceProvider    String? @db.VarChar(150)
  ambulancePlateNumber String? @db.VarChar(80)
  driverName           String? @db.VarChar(150)
  driverPhone          String? @db.VarChar(30)

  pickupAddress      String? @db.VarChar(255)
  destinationAddress String? @db.VarChar(255)

  transferDate DateTime
  feeAmount    Decimal  @default(0) @db.Decimal(12, 2)

  notes String? @db.VarChar(500)

  filedMonth  String?   @db.VarChar(7)
  filedAt     DateTime?
  filingNotes String?   @db.VarChar(500)

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation("SemsasRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  filedById String? @db.Char(36)
  filedBy   User?   @relation("SemsasFiledBy", fields: [filedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([transferType])
  @@index([patientId])
  @@index([transferDate])
  @@index([filedMonth])
  @@index([filedAt])
  @@index([recordedById])
  @@index([filedById])
  @@map("semsas_transfers")
}

model DoctorProfile {
  id String @id @default(uuid()) @db.Char(36)

  userId String @unique @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  doctorType DoctorType
  specialty  String?    @db.VarChar(150)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([doctorType])
  @@map("doctor_profiles")
}

model HospitalProfile {
  id String @id @default(uuid()) @db.Char(36)

  name      String @db.VarChar(150)
  shortName String @db.VarChar(50)

  email String @db.VarChar(150)
  phone String @db.VarChar(30)

  address String @db.VarChar(255)
  city    String @db.VarChar(100)
  state   String @db.VarChar(100)
  country String @db.VarChar(100)

  logoUrl  String? @db.VarChar(500)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hospital_profiles")
}

///////////////////////////////////////////////////////////////////////////////
// SECURITY ENTRY LOG
///////////////////////////////////////////////////////////////////////////////

model SecurityEntryLog {
  id String @id @default(uuid()) @db.Char(36)

  personType EntryPersonType

  name  String? @db.VarChar(150)
  phone String? @db.VarChar(30)

  patientId         String? @db.VarChar(50)
  staffIdCardNumber String? @db.VarChar(80)

  purpose     String? @db.VarChar(255)
  destination String? @db.VarChar(150)
  notes       String? @db.VarChar(500)

  photoUrl       String? @db.VarChar(500)
  photoDataUrl   String? @db.LongText
  photoMimeType  String? @db.VarChar(50)
  photoSizeBytes Int?
  photoWidth     Int?
  photoHeight    Int?

  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  recordedById String? @db.Char(36)
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([personType])
  @@index([phone])
  @@index([patientId])
  @@index([staffIdCardNumber])
  @@index([recordedById])
  @@index([checkedInAt])
  @@map("security_entry_logs")
}

///////////////////////////////////////////////////////////////////////////////
// ROLE
///////////////////////////////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Char(36)

  name String @unique @db.VarChar(100)

  description String? @db.VarChar(255)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  permissions RolePermission[]

  users UserRole[]

  @@map("roles")
}

///////////////////////////////////////////////////////////////////////////////
// PERMISSION
///////////////////////////////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Char(36)

  name String @unique @db.VarChar(150)

  description String? @db.VarChar(255)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

///////////////////////////////////////////////////////////////////////////////
// USER ROLE (Many-to-Many)
///////////////////////////////////////////////////////////////////////////////

model UserRole {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)

  roleId String @db.Char(36)

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

///////////////////////////////////////////////////////////////////////////////
// ROLE PERMISSION (Many-to-Many)
///////////////////////////////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Char(36)

  roleId String @db.Char(36)

  permissionId String @db.Char(36)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

///////////////////////////////////////////////////////////////////////////////
// REFRESH TOKENS
///////////////////////////////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(uuid()) @db.Char(36)

  token String @unique @db.VarChar(500)

  userId String @db.Char(36)

  expiresAt DateTime

  revoked Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

///////////////////////////////////////////////////////////////////////////////
// AUDIT LOG
///////////////////////////////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid()) @db.Char(36)

  action AuditAction

  entity String @db.VarChar(100)

  entityId String? @db.Char(36)

  oldValues Json?

  newValues Json?

  ipAddress String? @db.VarChar(45)

  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  userId String? @db.Char(36)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@map("audit_logs")
}
